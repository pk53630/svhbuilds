# Copy this file to .env and fill in real values before running in production.
# Example: cp .env.example .env   (Mac/Linux)   or   copy .env.example .env   (Windows)

PORT=4000

# Leave empty for local development (data stored in backend/data/db.json).
# For free cloud hosting, paste a free Neon Postgres connection string here —
# see deploy/FREE_SETUP_GUIDE.md. Data then survives server restarts.
DATABASE_URL=

# Secret used to sign JWT login tokens. Generate a long random string for production,
# e.g. run:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret

# How long a login session stays valid.
JWT_EXPIRES_IN=7d

# Password every new resident account starts with (admin tells it to the
# resident; the app forces them to change it on first login).
DEFAULT_USER_PASSWORD=Welcome@123

# ---- Notifications (both are stubbed/logged to the console and to data/notifications.log
#      until you fill these in) ----

# Gmail sending: create an "App Password" on the sender Gmail account
# (Google Account > Security > 2-Step Verification > App Passwords) and paste it here.
# See docs/DEPLOYMENT_AND_APPSTORE_GUIDE.md for step-by-step instructions.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# WhatsApp sending via the WhatsApp Business Cloud API (Meta).
# Requires a Meta developer account + WhatsApp Business app.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
